<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <!--
      网格地球（重画，替代旧 globe 图标）：
      - 全部路径用描边（stroke），没有任何填充区域 → 不再出现"左上角网格被
        背景填充封死"的渲染异常。
      - 外圈：圆环 = 地球轮廓（半径 9.2，圆心 (12,12)）。
      - 内部：横竖各两条线 = 3x3 经纬网格（端点在圆上，不越界）。
      path 结构：
        · 圆环：M12,12 m-9.2,0 a9.2,9.2 0 1,1 18.4,0 a9.2,9.2 0 1,1 -18.4,0
                起点 (2.8,12) → 上半圆 → (21.2,12) → 下半圆 → 回到起点
        · 横线 y=8 / y=16：x 从 3.72 到 20.28（r=9.2 时圆上对应点）
        · 竖线 x=8 / x=16：y 从 3.72 到 20.28
    -->
    <path
        android:pathData="M12,12 m-9.2,0 a9.2,9.2 0 1,1 18.4,0 a9.2,9.2 0 1,1 -18.4,0"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M3.72,8 L20.28,8"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M3.72,16 L20.28,16"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M8,3.72 L8,20.28"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M16,3.72 L16,20.28"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.2" />
</vector>
