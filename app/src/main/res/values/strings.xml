    <string name="service_groq_name">Groq（whisper-large-v3-turbo，最快）</string>
    <string name="service_groq_intro" formatted="false">超快推理的云端 Whisper，适合实时语音转写，免费额度大（约 1000 万 token/月）。</string>
    <string name="service_groq_register" formatted="false">注册：https://console.groq.com 注册 → API Keys 页创建 key（key 只显示一次）</string>
    <string name="service_groq_endpoint" formatted="false">端点：https://api.groq.com/openai/v1（Whisper 转写 /audio/transcriptions），模型 whisper-large-v3-turbo</string>
    <string name="service_groq_note">注意：需要国外网络</string>

    <string name="service_deepgram_name">Deepgram（Nova-3，专业语音）</string>
    <string name="service_deepgram_intro" formatted="false">专业 STT 服务商，Nova-3 中文效果好，新用户约 $200 免费额度。</string>
    <string name="service_deepgram_register" formatted="false">注册：https://console.deepgram.com 注册 → API Keys 页创建</string>
    <string name="service_deepgram_endpoint" formatted="false">端点：Deepgram 是专有 API（/v1/listen），不是 OpenAI 兼容</string>
    <string name="service_deepgram_note">注意：当前 Whisper 兼容接入不支持 Deepgram，标注"暂不支持，规划中"，需后续适配或走兼容网关</string>

    <string name="service_siliconflow_name">硅基流动 SiliconFlow</string>
    <string name="service_siliconflow_intro" formatted="false">国内平台，提供多种开源模型 API，有 Whisper 类语音模型，国内直连快。</string>
    <string name="service_siliconflow_register" formatted="false">注册：https://cloud.siliconflow.cn 注册 → API 密钥页新建（建议命名含用途）→ 密钥只显示一次</string>
    <string name="service_siliconflow_endpoint" formatted="false">端点：https://api.siliconflow.cn/v1（OpenAI 兼容），语音转写模型如 SenseVoiceSmall / whisper-large-v3</string>
    <string name="service_siliconflow_note">免费额度：注册送额度，具体以官网为准</string>

    <string name="service_glm_name">智谱 GLM-ASR</string>
    <string name="service_glm_intro">智谱开放平台语音识别，中文优化。</string>
    <string name="service_glm_register" formatted="false">注册：https://open.bigmodel.cn 注册 → API 密钥管理新建 key</string>
    <string name="service_glm_endpoint" formatted="false">端点：https://open.bigmodel.cn/api/paas/v4（OpenAI 兼容风格），语音相关模型/端点以平台文档为准</string>
    <string name="service_glm_note">注意：GLM-ASR 端点可能不是标准 /audio/transcriptions，以平台文档为准</string>

