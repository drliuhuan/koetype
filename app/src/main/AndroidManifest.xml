<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="com.drliuhuan.sayboardpro.SayboardProApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="34">

        <!-- 语音输入法本体 -->
        <service
            android:name="com.drliuhuan.sayboardpro.ime.SayboardProIME"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 设置页（也是启动入口） -->
        <activity
            android:name="com.drliuhuan.sayboardpro.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 识别模型进程：独立进程 :stt，常驻 sherpa recognizer。
             IME 进程每次收起/切换自杀后本服务继续存活（startService 保活），
             下次 IME bind 直接复用已加载模型（零加载延迟）。 -->
        <service
            android:name="com.drliuhuan.sayboardpro.stt.SttService"
            android:process=":stt"
            android:exported="false" />

        <!-- 崩溃日志导出：把 crash_logs 目录下的文件分享出去 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
